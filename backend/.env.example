# The SEC requires a "Name email" User-Agent on every request.
IS_SEC_USER_AGENT="InvestmentStation student@domain.com"

# Required for the Narrative Summary (Claude). Never commit a real key.
ANTHROPIC_API_KEY=

# Production: the deployed frontend's origin(s), comma-separated (or a JSON array). Defaults to localhost:3000.
# IS_CORS_ORIGINS=https://app.macropulse.example,https://www.macropulse.example

# Production server (gunicorn.conf.py): port and worker count. Keep 1 worker — see the note in that file.
# PORT=8000
# WEB_CONCURRENCY=1
